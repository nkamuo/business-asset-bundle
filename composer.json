{
    "name": "nkamuo/asset-bundle",
    "type": "symfony-bundle",
    "description": "A Symfony bundle for comprehensive asset management with Clean Architecture, CQRS pattern, and Ecotone framework integration",
    "keywords": ["symfony", "bundle", "asset-management", "cqrs", "clean-architecture", "ecotone"],
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/framework-bundle": "^7.0",
        "symfony/messenger": "^7.0",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/orm": "^3.0",
        "ramsey/uuid": "^4.7",
        "moneyphp/money": "^4.5",
        "symfony/uid": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/test-pack": "^1.1",
        "doctrine/doctrine-fixtures-bundle": "^3.6",
        "phpstan/phpstan": "^1.10",
        "symfony/phpunit-bridge": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Nkamuo\\AssetBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nkamuo\\AssetBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.0.*"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
