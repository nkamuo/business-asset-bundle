{
    "name": "nkamuo/business-asset-bundle",
    "type": "symfony-bundle",
    "version": "0.0.1",
    "description": "A Symfony bundle for comprehensive asset management with Clean Architecture, CQRS pattern, and Ecotone framework integration",
    "keywords": ["symfony", "bundle", "asset-management", "cqrs", "clean-architecture", "ecotone", "logistics", "transportation", "billing"],
    "homepage": "https://github.com/nkamuo/business-asset-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Nkamuo Asset Bundle Contributors",
            "email": "contributors@nkamuo.com"
        }
    ],
    "support": {
        "issues": "https://github.com/nkamuo/business-asset-bundle/issues",
        "source": "https://github.com/nkamuo/business-asset-bundle"
    },
    "require": {
        "php": "^8.2",
        "symfony/framework-bundle": "^7.0",
        "symfony/messenger": "^7.0",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/orm": "^3.0",
        "ramsey/uuid": "^4.7",
        "moneyphp/money": "^4.5",
        "symfony/uid": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "doctrine/doctrine-fixtures-bundle": "^3.6",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-symfony": "^1.3",
        "phpstan/phpstan-doctrine": "^1.3",
        "symfony/phpunit-bridge": "^7.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Nkamuo\\AssetBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nkamuo\\AssetBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.0.*"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "cs-fix": "php-cs-fixer fix --allow-risky=yes",
        "cs-check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "analyse": "phpstan analyse",
        "quality": [
            "@cs-check",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "test-coverage": "Run tests with coverage report", 
        "phpstan": "Run PHPStan static analysis",
        "psalm": "Run Psalm static analysis",
        "cs-fix": "Fix coding standards with PHP-CS-Fixer",
        "cs-check": "Check coding standards without fixing",
        "rector": "Run Rector refactoring",
        "quality": "Run all quality checks"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
